# Required
READECK_BASE_URL=https://readeck.example.com
READECK_API_TOKEN=your-api-token-here

# Optional TTS settings (defaults shown)
TTS_ENGINE=edge-tts
EDGE_TTS_VOICE=en-US-AriaNeural
MAX_CONCURRENT_JOBS=2

# Long articles are synthesised in pieces; each piece is retried on failure.
# TTS_CHUNK_CHARS=2000
# TTS_MAX_RETRIES=3

# Storage. Defaults suit the Docker image; override them to run outside a
# container, e.g. DATA_DIR=./data AUDIO_DIR=./audio
# DATA_DIR=/app/data
# AUDIO_DIR=/app/audio

# Optional HTTP basic auth. The app is unauthenticated unless BOTH are set —
# only run it that way on a trusted network.
# AUTH_USERNAME=
# AUTH_PASSWORD=

# Extra origins allowed to make state-changing requests, if the app sits
# behind a reverse proxy on a different hostname. Comma-separated.
# TRUSTED_ORIGINS=https://audiobook.example.com

# Worker tuning
# WORKER_POLL_SECONDS=2
# MAX_JOB_ATTEMPTS=3
# SHUTDOWN_GRACE_SECONDS=30

# Only relevant when TTS_ENGINE=kokoro (see docker-compose.kokoro.yml)
# KOKORO_VOICE=af_heart
# "cuda" needs the -kokoro-cuda image; the CPU image has no CUDA provider built in.
# KOKORO_PROVIDER=cpu
# KOKORO_NUM_THREADS=2
# Verbose sherpa-onnx output naming the execution providers that registered —
# the only way to confirm CUDA is really in use. Also logs the full text of every
# article, twice, so turn it back off once you've checked.
# KOKORO_DEBUG=1
# Where the sherpa-onnx Kokoro model lives; baked into the image at build time.
# KOKORO_MODEL_DIR=/app/models/kokoro
