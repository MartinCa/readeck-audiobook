# Required
READECK_BASE_URL=https://readeck.example.com
READECK_API_TOKEN=your-api-token-here

# Optional TTS settings (defaults shown)
TTS_ENGINE=edge-tts
EDGE_TTS_VOICE=en-US-AriaNeural
MAX_CONCURRENT_JOBS=2

# Only needed when TTS_ENGINE=ebook2audiobook
# (the default points to the ebook2audiobook service in docker-compose)
# EBOOK2AUDIOBOOK_URL=http://ebook2audiobook:7860
