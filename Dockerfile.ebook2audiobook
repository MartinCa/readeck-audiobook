# Variant image that bundles the ebook2audiobook runtime so TTS_ENGINE=ebook2audiobook
# can shell out to its --headless CLI locally instead of over an HTTP API it doesn't expose.
# Build with a different device tag via: --build-arg E2A_BASE_IMAGE=docker.io/athomasson2/ebook2audiobook:cpu
ARG E2A_BASE_IMAGE=docker.io/athomasson2/ebook2audiobook:v26.7.27-cu130
FROM ${E2A_BASE_IMAGE}

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt

COPY app/ ./app/
COPY static/ ./static/

RUN mkdir -p /app/audio /app/data

# The base image's entrypoint launches its own Gradio server; we don't want that
# running here — the app shells out to the headless CLI per job instead.
ENTRYPOINT []

EXPOSE 8080

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
