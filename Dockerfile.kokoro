# Variant image that bundles the Kokoro-82M TTS model so TTS_ENGINE=kokoro can run
# speech synthesis in-process instead of edge-tts. Kokoro runs on sherpa-onnx
# (onnxruntime), so this image shares the 3.14 base of the default Dockerfile.
#
# Build with --build-arg KOKORO_ACCEL=cuda for the GPU variant; see
# requirements-kokoro-cuda.txt.
FROM python:3.14-slim

ARG KOKORO_ACCEL=cpu

# The Kokoro model archive bundles its own espeak-ng-data, so unlike the
# torch-based build this needs no espeak-ng package.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    curl \
    bzip2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-kokoro.txt requirements-kokoro-cuda.txt .
RUN pip install --no-cache-dir -r requirements-kokoro.txt && \
    if [ "$KOKORO_ACCEL" = "cuda" ]; then \
        pip install --no-cache-dir -r requirements-kokoro-cuda.txt; \
    fi

# The CUDA build of sherpa-onnx links against the CUDA runtime libraries but
# ships none of them, so register the NVIDIA pip wheels' lib directories with
# the dynamic loader. Globbed rather than listed: every nvidia/*/lib directory
# that gets installed is picked up, so adding a library to
# requirements-kokoro-cuda.txt is all it takes to make it loadable.
#
# Then prove the closure is complete. onnxruntime loads the CUDA provider with
# dlopen at model-load time, so a missing library surfaces as a failed job hours
# later rather than a failed build — which is exactly how a missing libcurand
# shipped once already. `ldd` resolves the same libraries without needing a GPU,
# so this catches it on an ordinary CI runner.
RUN if [ "$KOKORO_ACCEL" = "cuda" ]; then \
        SHERPA=$(python -c "import importlib.util, pathlib; print(pathlib.Path(importlib.util.find_spec('sherpa_onnx').origin).parent)") && \
        find "$(dirname "$SHERPA")/nvidia" -type d -name lib > /etc/ld.so.conf.d/nvidia-pip.conf && \
        ldconfig && \
        PROVIDER="$SHERPA/lib/libonnxruntime_providers_cuda.so" && \
        if [ ! -f "$PROVIDER" ]; then \
            echo "ERROR: $PROVIDER is absent — the CPU sherpa-onnx wheel got installed instead of the +cuda12.cudnn9 one" >&2; \
            exit 1; \
        fi && \
        echo "Checking shared library closure of $PROVIDER" && \
        ldd "$PROVIDER" && \
        if ldd "$PROVIDER" | grep -q "not found"; then \
            echo "ERROR: unresolved libraries above — add the matching nvidia-*-cu12 wheel to requirements-kokoro-cuda.txt" >&2; \
            exit 1; \
        fi; \
    fi

# Bake the model in rather than downloading it on first use: startup becomes
# deterministic and there is no writable-cache-volume ownership to get wrong.
ARG KOKORO_MODEL=kokoro-multi-lang-v1_0
RUN curl -fsSL -o /tmp/kokoro.tar.bz2 \
      "https://github.com/k2-fsa/sherpa-onnx/releases/download/tts-models/${KOKORO_MODEL}.tar.bz2" && \
    mkdir -p /app/models/kokoro && \
    tar -xjf /tmp/kokoro.tar.bz2 -C /app/models/kokoro --strip-components=1 && \
    rm /tmp/kokoro.tar.bz2

COPY app/ ./app/
COPY static/ ./static/

RUN mkdir -p /app/audio /app/data && \
    useradd -r -u 1001 appuser && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
