{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>MartinCa/renovate-config:apps",
    "github>MartinCa/frontend-kit:renovate-frontend"
  ],
  "packageRules": [
    {
      "description": "sherpa-onnx has no CPython 3.15 wheels (PyPI or the k2-fsa CUDA index): keep the Kokoro image on 3.14 until it does",
      "matchFileNames": ["Dockerfile.kokoro"],
      "matchPackageNames": ["python", "docker.io/library/python"],
      "allowedVersions": "/^3\\.14(\\.|-|$)/"
    },
    {
      "description": "typescript-eslint supports TypeScript <6.1 (see frontend-kit docs/MAINTENANCE.md)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    }
  ]
}
